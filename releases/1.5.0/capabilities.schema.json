{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odyssey.w33d.xyz/library/capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "release", "expression", "assetBase", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": 1},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "expression": {"const": "line"},
    "assetBase": {"type": "string"},
    "components": {"type": "array", "minItems": 54, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "station", "maturity", "runtime", "html", "guide", "rust", "assets", "states", "design", "tests", "contract", "openTodo"],
      "properties": {
        "id": {"type": "string", "pattern": "^ody\\.[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "station": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "maturity": {"enum": ["supported", "preview", "deprecated"]},
        "runtime": {"enum": ["css", "native", "public", "extensions", "composition"]},
        "html": {"type": "string"},
        "guide": {"type": "string"},
        "rust": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "assets": {"type": "object", "additionalProperties": false, "required": ["css", "js"], "properties": {"css": {"type": "array", "items": {"type": "string"}}, "js": {"type": "array", "items": {"type": "string"}}}},
        "states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "design": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["nodeId"], "properties": {"nodeId": {"type": "string"}}}]},
        "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "coverage"], "properties": {"path": {"type": "string"}, "coverage": {"enum": ["specimen-smoke", "interaction-contract", "inventory"]}}}},
        "contract": {"type": "string"},
        "openTodo": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
